---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Technical Datasheet & Hardware Archive for Minty-Sniffle: Ultra-compact coin-cell-powered BLE environmental node and fire detection sensor.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        function applyTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          if (document.body) {
            document.body.setAttribute('data-theme', theme);
          }
          const iconEl = document.getElementById('theme-icon');
          const labelEl = document.getElementById('theme-label');
          if (iconEl) iconEl.textContent = theme === 'dark' ? '☀️' : '🌙';
          if (labelEl) labelEl.textContent = theme === 'dark' ? 'Light Mode' : 'Dark Mode';
          window.dispatchEvent(new CustomEvent('minty-theme-change', { detail: { theme: theme } }));
        }

        window.__toggleMintyTheme = function () {
          const current = document.documentElement.getAttribute('data-theme') || 'light';
          const next = current === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('minty-theme', next);
          } catch (_) {}
          applyTheme(next);
        };

        try {
          const saved = localStorage.getItem('minty-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (_) {}

        window.addEventListener('DOMContentLoaded', function () {
          const initial = document.documentElement.getAttribute('data-theme') || 'light';
          applyTheme(initial);
        });
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root,
  html[data-theme='light'],
  body[data-theme='light'] {
    --bg-canvas: #f6f7f4;
    --bg-sheet: #ffffff;
    --bg-elevated: #ffffff;
    --bg-topbar: rgba(255, 255, 255, 0.95);
    --bg-subtle: #f1f4f1;
    --bg-table-head: #f8fafc;
    --bg-table-hover: #f4f8f6;
    --bg-callout: #eef7f4;
    --bg-cad-stage: #fcfcfa;
    --bg-hud: rgba(255, 255, 255, 0.92);
    --grid-line: rgba(148, 163, 184, 0.14);
    --cad-dot: #cbd5e1;
    --ink-primary: #111827;
    --ink-secondary: #374151;
    --ink-muted: #6b7280;
    --ink-inverse: #ffffff;
    --badge-bg: #111827;
    --badge-ink: #ffffff;
    --border-strong: #1e293b;
    --border-mid: #cbd5e1;
    --border-hairline: #e2e8f0;
    --mint-accent: #0d9488;
    --mint-dark: #0f766e;
    --mint-soft: #ccfbf1;
    --mint-border: #99f6e4;
    --highlight-cell-bg: rgba(204, 251, 241, 0.3);
    --net-active-bg: #f0fdfa;
    --net-warn-bg: #fffbeb;
    --net-off-bg: #f8fafc;
    --amber-warn: #b45309;
    --font-sans: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color-scheme: light;
  }

  html[data-theme='dark'],
  body[data-theme='dark'] {
    --bg-canvas: #090d14;
    --bg-sheet: #111823;
    --bg-elevated: #172030;
    --bg-topbar: rgba(13, 19, 29, 0.95);
    --bg-subtle: #161f2e;
    --bg-table-head: #192334;
    --bg-table-hover: #1a2638;
    --bg-callout: #0f2427;
    --bg-cad-stage: #0d131d;
    --bg-hud: rgba(17, 24, 35, 0.92);
    --grid-line: rgba(45, 212, 191, 0.07);
    --cad-dot: #26354a;
    --ink-primary: #f1f5f9;
    --ink-secondary: #cbd5e1;
    --ink-muted: #94a3b8;
    --ink-inverse: #090d14;
    --badge-bg: #14b8a6;
    --badge-ink: #042f2e;
    --border-strong: #334155;
    --border-mid: #263548;
    --border-hairline: #1e293b;
    --mint-accent: #14b8a6;
    --mint-dark: #2dd4bf;
    --mint-soft: rgba(20, 184, 166, 0.16);
    --mint-border: rgba(45, 212, 191, 0.38);
    --highlight-cell-bg: rgba(20, 184, 166, 0.14);
    --net-active-bg: rgba(20, 184, 166, 0.16);
    --net-warn-bg: rgba(245, 158, 11, 0.16);
    --net-off-bg: #141c29;
    --amber-warn: #fbbf24;
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    scroll-behavior: smooth;
    background-color: var(--bg-canvas);
    color: var(--ink-primary);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  body {
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 24px 24px;
    min-height: 100vh;
  }

  code, pre, .mono {
    font-family: var(--font-mono);
  }

  @media print {
    body {
      background: #ffffff;
    }
    .no-print {
      display: none !important;
    }
  }
</style>
