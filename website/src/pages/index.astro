  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .action-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.4rem 0.75rem;
    background: var(--bg-elevated);
    color: var(--ink-primary);
    border: 1px solid var(--border-mid);
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .action-btn:hover {
    border-color: var(--mint-accent);
    background: var(--bg-subtle);
  }

  .theme-btn {
    border-color: var(--mint-accent);
    background: var(--bg-callout);
  }

  .primary-btn {
    background: var(--badge-bg);
    color: var(--badge-ink);
    border-color: var(--badge-bg);
    font-weight: 600;
  }

  .primary-btn:hover {
    background: var(--mint-dark);
    border-color: var(--mint-dark);
    color: var(--ink-inverse);
  }

  /* Main Datasheet Sheet */
  .datasheet-container {
    max-width: 1380px;
    margin: 1.75rem auto 3rem;
    padding: 0 1.5rem;
  }

  .title-block {
    background: var(--bg-sheet);
    border: 2px solid var(--border-strong);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    margin-bottom: 2rem;
  }

  .title-block-top {
    display: grid;
    grid-template-columns: 1fr 310px;
    border-bottom: 2px solid var(--border-strong);
  }

  .title-block-left {
    padding: 1.75rem 2rem;
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.76rem;
    color: var(--ink-muted);
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }

  .lab-tag {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--mint-dark);
    background: var(--mint-soft);
    padding: 0.12rem 0.45rem;
  }

  .title-block h1 {
    font-size: 2.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 0.45rem;
  }

  .subtitle {
    font-size: 1.08rem;
    color: var(--ink-secondary);
    max-width: 780px;
  }

  .title-block-stamp {
    border-left: 2px solid var(--border-strong);
    background: var(--bg-subtle);
    padding: 1.15rem;
    display: flex;
    align-items: center;
  }

  .stamp-box {
    width: 100%;
    border: 1px solid var(--border-mid);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  .stamp-header {
    background: var(--badge-bg);
    color: var(--badge-ink);
    padding: 0.3rem 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .stamp-row {
    display: flex;
    justify-content: space-between;
    padding: 0.28rem 0.65rem;
    border-top: 1px solid var(--border-hairline);
  }

  .stamp-link {
    color: var(--mint-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .mint-text {
    color: var(--mint-dark);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    background: var(--bg-sheet);
  }

  .summary-cell {
    padding: 1rem 1.25rem;
    border-right: 1px solid var(--border-mid);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .summary-cell:last-child {
    border-right: none;
  }

  .cell-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink-muted);
    letter-spacing: 0.05em;
  }

  .cell-value {
    font-size: 0.98rem;
    color: var(--ink-primary);
  }

  .cell-sub {
    font-size: 0.76rem;
    color: var(--ink-secondary);
  }

  /* Section Styling */
  .doc-section {
    background: var(--bg-sheet);
    border: 1.5px solid var(--border-strong);
    margin-bottom: 2rem;
    padding: 1.75rem 2rem 2rem;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.06);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-strong);
  }

  .section-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--badge-ink);
    background: var(--badge-bg);
    padding: 0.2rem 0.55rem;
    letter-spacing: 0.05em;
  }

  .section-header h2 {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .section-lead {
    color: var(--ink-secondary);
    margin-bottom: 1.25rem;
    max-width: 1050px;
  }

  .section-lead code {
    font-size: 0.85em;
    background: var(--bg-subtle);
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border-mid);
  }

  /* 3D Render Strip */
  .mcad-renders-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .render-tile {
    border: 1px solid var(--border-mid);
    background: var(--bg-subtle);
    display: flex;
    flex-direction: column;
  }

  .render-tile-head {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.45rem 0.75rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-mid);
    color: var(--ink-secondary);
  }

  .render-tile img {
    width: 100%;
    height: 190px;
    object-fit: contain;
    padding: 0.85rem;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.18));
  }

  /* Section 01 Layout */
  .two-col-overview {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    margin-bottom: 1.75rem;
  }

  .prose-box h3,
  .sub-heading {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 1.1rem 0 0.55rem;
    color: var(--ink-primary);
    font-family: var(--font-mono);
    letter-spacing: -0.01em;
  }

  .prose-box h3:first-child {
    margin-top: 0;
  }

  .prose-box p {
    color: var(--ink-secondary);
    margin-bottom: 0.85rem;
  }

  .prose-box a {
    color: var(--mint-dark);
    font-weight: 600;
  }

  .spec-list {
    padding-left: 1.2rem;
    color: var(--ink-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .spec-list code {
    font-size: 0.85em;
    background: var(--bg-subtle);
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border-mid);
  }

  .board-preview-card {
    border: 1px solid var(--border-mid);
    background: var(--bg-subtle);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .preview-header {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border-mid);
    background: var(--bg-elevated);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
  }

  .mini-link {
    font-family: var(--font-mono);
    color: var(--mint-dark);
    text-decoration: none;
    font-weight: 600;
  }

  .preview-img-wrap {
    padding: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
    background: var(--bg-cad-stage);
  }

  .preview-img-wrap img {
    max-width: 100%;
    max-height: 270px;
    object-fit: contain;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.18));
  }

  .preview-caption {
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--border-mid);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    display: flex;
    justify-content: space-between;
    color: var(--ink-secondary);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Datasheet Tables */
  .table-block {
    border: 1px solid var(--border-strong);
    background: var(--bg-sheet);
  }

  .table-caption {
    background: var(--bg-subtle);
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-primary);
    letter-spacing: 0.03em;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .datasheet-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }

  .datasheet-table th {
    background: var(--bg-table-head);
    color: var(--ink-primary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: left;
    padding: 0.6rem 0.85rem;
    border-bottom: 1.5px solid var(--border-strong);
    border-right: 1px solid var(--border-hairline);
  }

  .datasheet-table td {
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--border-hairline);
    border-right: 1px solid var(--border-hairline);
    vertical-align: top;
  }

  .datasheet-table tr:hover td {
    background: var(--bg-table-hover);
  }

  .num-col {
    text-align: right;
    white-space: nowrap;
  }

  .highlight-cell {
    color: var(--mint-dark);
    font-weight: 600;
    background: var(--highlight-cell-bg);
  }

  .muted-cell {
    color: var(--ink-muted);
    font-size: 0.78rem;
  }

  .notes-col {
    color: var(--ink-secondary);
  }

  /* Soft-Power Latch Simulator */
  .latch-simulator-box {
    border: 1.5px solid var(--mint-accent);
    background: var(--bg-callout);
    padding: 1.35rem;
    margin-bottom: 2rem;
  }

  .sim-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 1.15rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--mint-border);
  }

  .sim-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--badge-bg);
    color: var(--badge-ink);
    padding: 0.15rem 0.5rem;
    display: inline-block;
    margin-bottom: 0.35rem;
  }

  .sim-header h3 {
    font-size: 1.15rem;
    margin-bottom: 0.2rem;
  }

  .sim-header p {
    font-size: 0.88rem;
    color: var(--ink-secondary);
  }

  .sim-buttons {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .sim-step-btn {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    padding: 0.5rem 0.8rem;
    background: var(--bg-elevated);
    color: var(--ink-primary);
    border: 1px solid var(--border-mid);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sim-step-btn:hover {
    border-color: var(--mint-dark);
  }

  .sim-step-btn.active {
    background: var(--badge-bg);
    color: var(--badge-ink);
    border-color: var(--badge-bg);
    font-weight: 600;
  }

  .net-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .net-state-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-mid);
    border-left: 4px solid var(--border-strong);
    padding: 0.65rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
  }

  .net-state-card[data-state='active'] {
    border-left-color: var(--mint-accent);
    background: var(--net-active-bg);
  }

  .net-state-card[data-state='warn'] {
    border-left-color: var(--amber-warn);
    background: var(--net-warn-bg);
  }

  .net-state-card[data-state='off'] {
    border-left-color: #64748b;
    background: var(--net-off-bg);
  }

  .net-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .net-val {
    font-family: var(--font-mono);
    font-size: 0.94rem;
    color: var(--ink-primary);
  }

  .net-desc {
    font-size: 0.75rem;
    color: var(--ink-secondary);
  }

  .sim-explanation {
    background: var(--bg-elevated);
    border: 1px solid var(--border-mid);
    padding: 0.9rem 1.1rem;
  }

  .sim-step-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--mint-dark);
    margin-bottom: 0.3rem;
  }

  /* Subsystem Grid */
  .subsystem-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .subsystem-card {
    border: 1px solid var(--border-mid);
    background: var(--bg-elevated);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sub-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .sub-code {
    font-size: 0.74rem;
    font-weight: 600;
    background: var(--badge-bg);
    color: var(--badge-ink);
    padding: 0.14rem 0.45rem;
  }

  .sub-refs {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .ref-chip {
    font-size: 0.7rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-mid);
    padding: 0.08rem 0.38rem;
    color: var(--ink-secondary);
  }

  .subsystem-card h4 {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .sub-summary {
    font-size: 0.87rem;
    color: var(--ink-secondary);
  }

  .sub-kv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    background: var(--bg-subtle);
    padding: 0.65rem;
    border: 1px solid var(--border-hairline);
  }

  .kv-item {
    display: flex;
    flex-direction: column;
  }

  .kv-label {
    font-size: 0.68rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    font-family: var(--font-mono);
  }

  .kv-val {
    font-size: 0.77rem;
    color: var(--ink-primary);
  }

  .sub-details {
    padding-left: 1.1rem;
    font-size: 0.83rem;
    color: var(--ink-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  /* CAD Viewer */
  .cad-viewer-wrapper {
    border: 1.5px solid var(--border-strong);
    background: var(--bg-elevated);
  }

  .cad-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.9rem;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border-strong);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cad-layer-tabs {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .cad-tab {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 0.4rem 0.75rem;
    background: var(--bg-elevated);
    color: var(--ink-primary);
    border: 1px solid var(--border-mid);
    cursor: pointer;
  }

  .cad-tab.active {
    background: var(--badge-bg);
    color: var(--badge-ink);
    border-color: var(--badge-bg);
    font-weight: 600;
  }

  .cad-controls {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .ctrl-btn {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 0.32rem 0.65rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-mid);
    cursor: pointer;
    text-decoration: none;
    color: var(--ink-primary);
  }

  .ctrl-btn:hover {
    border-color: var(--mint-accent);
  }

  .zoom-readout {
    font-size: 0.76rem;
    min-width: 48px;
    text-align: center;
  }

  .cad-viewport {
    height: 620px;
    overflow: hidden;
    position: relative;
    background-color: #fcfcfa;
    background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
    background-size: 18px 18px;
    cursor: grab;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cad-viewport.grabbing {
    cursor: grabbing;
  }

  .cad-canvas {
    transform-origin: center center;
    transition: transform 0.06s ease-out;
    max-width: 95%;
    max-height: 95%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cad-canvas img {
    max-width: 100%;
    max-height: 580px;
    object-fit: contain;
    user-select: none;
  }

  .cad-footer {
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--border-mid);
    background: var(--bg-subtle);
    display: flex;
    justify-content: space-between;
    font-size: 0.76rem;
    color: var(--ink-secondary);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Filter Bars (BOM & Pinout) */
  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .category-pills {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .pill-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.38rem 0.75rem;
    background: var(--bg-subtle);
    color: var(--ink-primary);
    border: 1px solid var(--border-mid);
    cursor: pointer;
  }

  .pill-btn.active {
    background: var(--badge-bg);
    color: var(--badge-ink);
    border-color: var(--badge-bg);
    font-weight: 600;
  }

  .search-and-export {
    display: flex;
    gap: 0.5rem;
    flex: 1;
    max-width: 520px;
    justify-content: flex-end;
  }

  .lab-search {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.42rem 0.75rem;
    border: 1px solid var(--border-mid);
    background: var(--bg-elevated);
    color: var(--ink-primary);
  }

  .lab-search:focus {
    outline: 2px solid var(--mint-accent);
    border-color: var(--mint-dark);
  }

  .cat-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.12rem 0.42rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-mid);
    white-space: nowrap;
  }

  .net-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--mint-dark);
    background: var(--mint-soft);
    padding: 0.1rem 0.42rem;
    border: 1px solid var(--mint-border);
  }

  /* Section 07 Build Log, Chat Archives & Datasheets */
  .chat-archives-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .chat-archive-card {
    border: 1.5px solid var(--border-mid);
    background: var(--bg-elevated);
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: var(--ink-primary);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: all 0.15s ease;
  }

  .chat-archive-card:hover {
    border-color: var(--mint-accent);
    background: var(--bg-callout);
    transform: translateY(-2px);
  }

  .chat-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
  }

  .chat-id-badge {
    background: var(--badge-bg);
    color: var(--badge-ink);
    padding: 0.1rem 0.42rem;
    font-weight: 600;
  }

  .chat-platform {
    color: var(--mint-dark);
    font-weight: 600;
  }

  .chat-archive-card h4 {
    font-size: 0.92rem;
    line-height: 1.3;
  }

  .chat-archive-card p {
    font-size: 0.78rem;
    color: var(--ink-secondary);
  }

  .two-col-log {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 2rem;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .timeline-card {
    border: 1px solid var(--border-mid);
    border-left: 4px solid var(--mint-accent);
    padding: 1.2rem 1.35rem;
    background: var(--bg-elevated);
  }

  .timeline-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.72rem;
    flex-wrap: wrap;
  }

  .date-chip {
    background: var(--badge-bg);
    color: var(--badge-ink);
    padding: 0.12rem 0.48rem;
    font-weight: 600;
  }

  .run-chip {
    color: var(--ink-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border-hairline);
