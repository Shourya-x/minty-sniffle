    border-radius: 3px;
  }

  .section-tabs {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .tab-link {
    text-decoration: none;
    color: var(--ink-secondary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    padding: 0.36rem 0.62rem;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .tab-link:hover {
    background: var(--bg-subtle);
